#!/bin/sh
# Nightly run on fortyard: every test, the slow ones included, run again.
# fortyard splits it over runners (policy verify_shards) and sets
# FORTYARD_SHARD=K/N; this shard then runs part K, balanced by the tests'
# declared TIMEOUT times PROCESSORS. The log ends with the slowest tests, which
# survive when the server cuts the middle of a long log.
set -eu
export OPENBLAS_NUM_THREADS=1 MPLBACKEND=Agg FO_TEST_RERUN=1
fo build
if [ -n "${FORTYARD_SHARD:-}" ]; then
    exec fo test --all --durations 60 --partition "cost:$FORTYARD_SHARD"
fi
exec fo test --all --durations 60
