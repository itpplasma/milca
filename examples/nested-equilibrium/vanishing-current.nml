! circular tokamak with I = 0.01 s A: iota ~ 1e-9, zero within current_tolerance
&nested_input
  nfp = 1, mpol = 1, ntor = 0, phiedge = 1.0,
  rbc(0,0) = 3.0, rbc(0,1) = 1.0, zbs(0,1) = 1.0,
  iota(0) = 0.3, prescribe_current = .true., current(1) = 0.01,
  boundary_nodes = 16, degree = 3, angle_mpol = 2, tolerance = 1e-8
/
