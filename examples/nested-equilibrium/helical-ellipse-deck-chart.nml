! helical-ellipse.nml in the curve chart along the boundary's m = 0 curve: the
! sections stay centred, and the frame turns with the helix, so the map needs
! more toroidal modes than the boundary
&nested_input
  nfp = 5, mpol = 1, ntor = 1, phiedge = 0.035,
  rbc(0,0) = 0.78, rbc(-1,0) = 0.05, zbs(-1,0) = 0.05,
  rbc(0,1) = 0.13, zbs(0,1) = 0.16,
  iota(0) = 0.9, iota(1) = -0.3, pressure(0) = 400.0, pressure(1) = -400.0,
  boundary_nodes = 12, degree = 3, angle_mpol = 4, map_ntor = 4, tolerance = 1e-8,
  chart = 'deck'
/
