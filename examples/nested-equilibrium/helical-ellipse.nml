! nfp 5 ellipse (0.13 m x 0.16 m) whose centre turns on a 5 cm helix, with
! pressure and shear, in the cylindrical chart: the reference for the same
! deck in the deck chart (helical-ellipse-deck-chart.nml)
&nested_input
  nfp = 5, mpol = 1, ntor = 1, phiedge = 0.035,
  rbc(0,0) = 0.78, rbc(-1,0) = 0.05, zbs(-1,0) = 0.05,
  rbc(0,1) = 0.13, zbs(0,1) = 0.16,
  iota(0) = 0.9, iota(1) = -0.3, pressure(0) = 400.0, pressure(1) = -400.0,
  boundary_nodes = 12, degree = 3, angle_mpol = 4, map_ntor = 2, tolerance = 1e-8
/
